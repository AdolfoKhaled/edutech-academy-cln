# Copia este archivo como .env y ajusta los valores. NO subas .env al repositorio.
# Valores de ejemplo, sin secretos reales.

# Base de datos. Local sin Docker: SQLite en un archivo. En Docker Compose se arma con POSTGRES_*.
DATABASE_URL=sqlite:///./edutech.db
POSTGRES_DB=edutech
POSTGRES_USER=edutech
POSTGRES_PASSWORD=cambia_esta_contrasena

# desarrollo | docker | produccion
APP_ENV=desarrollo

# true: si la base está vacía, carga el paquete de datos ficticios (datos/*.csv) al arrancar
CARGAR_DATOS_DEMO=true

# Usuarios de demostración para el encabezado X-Usuario (usuario:Rol;usuario:Rol)
ROLES_DEMO=inst-1:Instructor;inst-2:Instructor;ce-1:ControlEscolar;coord-1:CoordinacionAcademica
